# Environment Variables — Copy to .env and fill in values
# Never commit .env to source control

# ── Backend (Cloudflare Worker / local dev) ──────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@smhgloballogistics.com
ADMIN_PASSWORD=change-this-before-first-run

# CORS — comma-separated allowed origins
API_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.pages.dev

# ── Frontend ─────────────────────────────────────────────────────────────────
# In development the Vite proxy handles /api → localhost:8787
# In production set this to your Worker URL
VITE_API_BASE_URL=http://localhost:8787
